# Copy to generator/.env (git-ignored) and fill in.
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional: model for research/review, and a stronger one for writing/editing.
# Run the generator and open /api/models to see what your key can use.
GEMINI_MODEL=gemini-flash-lite-latest
GEMINI_WRITER_MODEL=gemini-flash-lite-latest
# Tried in order when a model is overloaded or out of quota.
GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-flash-latest,gemini-2.5-flash
# Models that can use Google Search on a free-tier key (tried for research after the chain above).
GEMINI_SEARCH_MODELS=gemini-2.5-flash
# The Reviewer (quality gate) uses a stronger model than the rest:
GEMINI_REVIEW_MODEL=gemini-2.5-flash

# GEN_PORT=4400

# Local model (Ollama). Used in Auto mode once Gemini's free quota runs out, and in Local mode.
OLLAMA_MODEL=gemma4:12b-it-qat
# Context window for the local model; the desk's notes need ~16k.
OLLAMA_CTX=16384

# Web search for current prices, timings and news. Set ONE of these (both are free):
#   Ollama web search: free Ollama account, key at https://ollama.com/settings/keys
#   Tavily: 1,000 free credits a month, no card, key at https://app.tavily.com
# Without either, agents use Wikivoyage and Wikipedia only.
OLLAMA_API_KEY=
TAVILY_API_KEY=
# SEARCH_PROVIDER=ollama   # or tavily, when both keys are set
