---
import { render } from "astro:content";
import { Image, getImage } from "astro:assets";
import Base from "../../../layouts/Base.astro";
import StoryCard from "../../../components/StoryCard.astro";
import AdSlot from "../../../components/AdSlot.astro";
import { getPosts, relatedPosts, seriesPosts, formatDate, slugify, placeLabel, type Post } from "../../../lib/posts";
import { SITE, url, absUrl } from "../../../site";
import { hasPaidLinks } from "../../../affiliates.mjs";

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => {
    // Series stories page through their own series; everything else through all stories.
    const list = post.series ? seriesPosts(posts, post.series) : posts;
    const i = list.indexOf(post);
    return {
      params: { year: post.year, slug: post.slug },
      props: { post, newer: list[i - 1], older: list[i + 1] },
    };
  });
}

interface Props {
  post: Post;
  newer?: Post;
  older?: Post;
}
const { post, newer, older } = Astro.props;
const { Content, headings } = await render(post.entry);
const toc = headings.filter((h) => h.depth === 2);
const allPosts = await getPosts();
const sameSeries = post.series ? seriesPosts(allPosts, post.series).filter((p) => p.id !== post.id).slice(0, 3) : [];
const related = sameSeries.length ? sameSeries : relatedPosts(post, allPosts, 3);
const { cover, coverAlt, tripDates, author, era, facts } = post.entry.data;
const where = placeLabel(post);
const series = post.series ? SITE.series[post.series as keyof typeof SITE.series] : undefined;
const affiliate = hasPaidLinks(post.entry.body);
const pageUrl = absUrl(post.path);
const og = cover ? await getImage({ src: cover, width: 1200, height: 630, fit: "cover", format: "jpg" }) : undefined;
const ogImage = og ? new URL(og.src, SITE.origin).href : undefined;
const reactKey = `${post.year}-${post.slug}`;
const enc = encodeURIComponent;
const shareText = `${post.title} ${pageUrl}`;
const shareLinks = [
  { net: "whatsapp", label: "WhatsApp", href: `https://wa.me/?text=${enc(shareText)}` },
  { net: "facebook", label: "Facebook", href: `https://www.facebook.com/sharer/sharer.php?u=${enc(pageUrl)}` },
  { net: "x", label: "X", href: `https://x.com/intent/post?url=${enc(pageUrl)}&text=${enc(post.title)}` },
  { net: "telegram", label: "Telegram", href: `https://t.me/share/url?url=${enc(pageUrl)}&text=${enc(post.title)}` },
  { net: "linkedin", label: "LinkedIn", href: `https://www.linkedin.com/sharing/share-offsite/?url=${enc(pageUrl)}` },
  { net: "pinterest", label: "Pinterest", href: `https://pinterest.com/pin/create/button/?url=${enc(pageUrl)}&description=${enc(post.title)}${ogImage ? `&media=${enc(ogImage)}` : ""}` },
  { net: "email", label: "Email", href: `mailto:?subject=${enc(post.title)}&body=${enc(`${post.description}\n\n${pageUrl}`)}` },
];

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    headline: post.title,
    description: post.seoDescription,
    datePublished: post.date.toISOString(),
    dateModified: (post.updated ?? post.date).toISOString(),
    mainEntityOfPage: { "@type": "WebPage", "@id": pageUrl },
    url: pageUrl,
    ...(ogImage ? { image: { "@type": "ImageObject", url: ogImage, width: 1200, height: 630, ...(coverAlt ? { caption: coverAlt } : {}) } } : {}),
    wordCount: post.wordCount,
    keywords: post.tags.join(", "),
    inLanguage: SITE.lang,
    ...(where
      ? { contentLocation: { "@type": "Place", name: where, ...(post.country ? { address: { "@type": "PostalAddress", addressCountry: post.country } } : {}) } }
      : {}),
    articleSection: series?.label ?? "Travel",
    author: { "@type": "Person", name: author, url: absUrl("/about/"), sameAs: [SITE.socials.linkedin, SITE.socials.github] },
    publisher: { "@type": "Person", name: SITE.author, url: SITE.socials.website },
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Stories", item: absUrl("/stories/") },
      ...(post.country
        ? [{ "@type": "ListItem", position: 2, name: post.country, item: absUrl(`/places/${slugify(post.country)}/`) }]
        : []),
      { "@type": "ListItem", position: post.country ? 3 : 2, name: post.title, item: pageUrl },
    ],
  },
];
---

<Base
  title={post.seoTitle}
  description={post.seoDescription}
  path={post.path}
  type="article"
  image={ogImage}
  imageAlt={coverAlt}
  imageWidth={ogImage ? 1200 : undefined}
  imageHeight={ogImage ? 630 : undefined}
  jsonLd={jsonLd}
  published={post.date}
  modified={post.updated}
  tags={post.tags}
>
  <div class="progress" aria-hidden="true"></div>
  <article data-pagefind-body class:list={[{ "series-story": series }, post.series && `series-${post.series}`]}>
    <header class:list={["story-hero", { "has-cover": cover }]}>
      {
        cover && (
          <Image
            class="story-hero-img"
            src={cover}
            alt={coverAlt ?? ""}
            layout="full-width"
            widths={[640, 960, 1280, 1600, 2000]}
            sizes="100vw"
            loading="eager"
            fetchpriority="high"
          />
        )
      }
      <div class="wrap narrow story-hero-text">
        <nav class="breadcrumbs" aria-label="Breadcrumb" data-pagefind-ignore>
          <ol>
            <li><a href={url("/stories/")}>Stories</a></li>
            {series && <li><a href={url(series.path)}>{series.label}</a></li>}
            {post.country && <li><a href={url(`/places/${slugify(post.country)}/`)}>{post.country}</a></li>}
          </ol>
        </nav>
        {post.draft && <p class="draft-badge static">Draft · only visible in local dev</p>}
        {series && <p class="eyebrow series-eyebrow">{series.label} · No. {post.seriesNo}</p>}
        <h1 data-pagefind-meta="title">{post.title}</h1>
        {post.entry.data.description && <p class="lede">{post.entry.data.description}</p>}
        <div class="meta" data-pagefind-ignore>
          {where && <span>📍 {where}</span>}
          {tripDates && <span>{tripDates}</span>}
          {era && <span>🏛 {era}</span>}
          <time datetime={post.date.toISOString()} data-pagefind-meta="date">{formatDate(post.date)}</time>
          {post.updated && post.updated.valueOf() > post.date.valueOf() && (
            <span>Updated <time datetime={post.updated.toISOString()}>{formatDate(post.updated)}</time></span>
          )}
          <span>{post.readingMinutes} min read</span>
          <span data-views hidden><b data-count="view">0</b> <span data-view-word>views</span></span>
        </div>
      </div>
    </header>

    <div class="wrap narrow">
      <div class="story-tools" data-pagefind-ignore>
        <span class="muted">By {author}</span>
        <a class="react-summary" href="#reactions" data-react-summary hidden aria-label="Likes, loves and shares">
          <span>👍 <b data-count="like">0</b></span><span>❤️ <b data-count="love">0</b></span><span>↗ <b data-count="share">0</b></span>
        </a>
        <div class="share">
          <button class="icon-btn" type="button" data-share aria-label="Share this story">
            <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path d="M4 12v7a1 1 0 0 0 1 1h14a1 1 0 0 0 1-1v-7M16 6l-4-4-4 4M12 2v13" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg>
            <span>Share</span>
          </button>
          <a class="icon-btn" href={shareLinks[0].href} target="_blank" rel="noopener" data-share-net="whatsapp" aria-label="Share on WhatsApp">WA</a>
          <a class="icon-btn" href={shareLinks[2].href} target="_blank" rel="noopener" data-share-net="x" aria-label="Share on X">𝕏</a>
        </div>
      </div>

      {
        affiliate && (
          <p class="aff-disclosure" data-pagefind-ignore>
            Some links in this story are affiliate links: if you book through them, the blog earns a small commission at no extra cost to you. Picks are chosen on reviews and value, never on commission.
          </p>
        )
      }

      {
        facts && facts.length > 0 && (
          <aside class="fact-file" aria-labelledby="fact-file-title">
            <h2 id="fact-file-title">Fact file</h2>
            <dl>
              {facts.map((f) => (
                <div>
                  <dt>{f.label}</dt>
                  <dd>{f.value}</dd>
                </div>
              ))}
            </dl>
          </aside>
        )
      }

      {
        toc.length > 2 && (
          <details class="toc" data-pagefind-ignore>
            <summary>In this story</summary>
            <ol>
              {toc.map((h) => (
                <li><a href={`#${h.slug}`}>{h.text.replace(/#$/, "")}</a></li>
              ))}
            </ol>
          </details>
        )
      }

      <div class="prose">
        <Content />
      </div>

      <div hidden data-insert-at="0.35" data-pagefind-ignore><AdSlot slot="inArticle" format="fluid" layout="in-article" /></div>
      <AdSlot slot="endOfPost" />

      <section class="reactions" id="reactions" data-pagefind-ignore aria-labelledby="reactions-title">
        <h2 id="reactions-title">Enjoyed this story?</h2>
        <div class="react-row">
          <button class="react-btn" type="button" data-react="like" aria-pressed="false">
            <span aria-hidden="true">👍</span> Like <b data-count="like" hidden>0</b>
          </button>
          <button class="react-btn" type="button" data-react="love" aria-pressed="false">
            <span aria-hidden="true">❤️</span> Love <b data-count="love" hidden>0</b>
          </button>
          <span class="share-tally" data-share-tally hidden>Shared <b data-count="share">0</b> <span data-share-word>times</span></span>
        </div>
        <p class="muted">{series ? "Pass it on to someone who loves a good story:" : "Pass it on to someone planning a trip:"}</p>
        <div class="share-row">
          {shareLinks.map((l) => (
            <a class:list={["share-btn", `share-${l.net}`]} href={l.href} target={l.net === "email" ? undefined : "_blank"} rel="noopener" data-share-net={l.net}>{l.label}</a>
          ))}
          <button class="share-btn" type="button" data-copy-link>Copy link</button>
        </div>
      </section>

      <footer class="post-foot" data-pagefind-ignore>
        {
          post.tags.length > 0 && (
            <div class="chip-row">
              {post.tags.map((t) => (
                <a class="tag" href={url(`/tags/${slugify(t)}/`)}>#{t}</a>
              ))}
            </div>
          )
        }
        <nav class="post-nav" aria-label="More stories">
          {older && (
            <a href={url(older.path)} rel="prev">
              <small>{series ? `← ${series.label} No. ${older.seriesNo}` : "← Previous story"}</small>
              {older.title}
            </a>
          )}
          {newer && (
            <a class="next" href={url(newer.path)} rel="next">
              <small>{series ? `${series.label} No. ${newer.seriesNo} →` : "Next story →"}</small>
              {newer.title}
            </a>
          )}
        </nav>
      </footer>
    </div>

    {
      related.length > 0 && (
        <section class="wrap related" data-pagefind-ignore>
          <div class="section-title"><h2>{sameSeries.length && series ? `More from ${series.label}` : "More from the road"}</h2></div>
          <div class="story-grid">{related.map((p) => <StoryCard post={p} heading="h3" />)}</div>
        </section>
      )
    }
  </article>

  <button class="icon-btn to-top" type="button" aria-label="Back to top" data-to-top>↑</button>
  <div class="toast" role="status" aria-live="polite"></div>
  <script is:inline type="application/json" id="post-config" set:html={JSON.stringify({ title: post.title, url: pageUrl, react: SITE.reactions.api ? { api: SITE.reactions.api, ns: import.meta.env.DEV ? `${SITE.reactions.namespace}-dev` : SITE.reactions.namespace, key: reactKey } : null })} />
  <script>
    import { initPost } from "../../../lib/post-client";
    initPost();
  </script>
</Base>
