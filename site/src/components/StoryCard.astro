---
import { Image } from "astro:assets";
import type { Post } from "../lib/posts";
import { formatDate, placeLabel } from "../lib/posts";
import { url } from "../site";

interface Props {
  post: Post;
  heading?: "h2" | "h3";
  eager?: boolean;
}
const { post, heading = "h2", eager = false } = Astro.props;
const H = heading;
const { cover, coverAlt } = post.entry.data;
const where = placeLabel(post);
---

<article class="story-card">
  <div class="story-media">
    {
      cover ? (
        <Image
          src={cover}
          alt={coverAlt ?? ""}
          width={720}
          height={480}
          fit="cover"
          layout="full-width"
          widths={[360, 540, 720]}
          sizes="(min-width: 1100px) 360px, (min-width: 720px) 50vw, 100vw"
          loading={eager ? "eager" : "lazy"}
        />
      ) : (
        <div class="story-media-empty" aria-hidden="true">
          <span>{post.place ?? post.country ?? "✈"}</span>
        </div>
      )
    }
    {where && <span class="story-place">{where}</span>}
    {post.draft && <span class="draft-badge">Draft</span>}
  </div>
  <div class="story-body">
    <div class="meta">
      <time datetime={post.date.toISOString()}>{formatDate(post.date)}</time>
      <span>{post.readingMinutes} min read</span>
    </div>
    <H><a href={url(post.path)}>{post.title}</a></H>
    <p>{post.description}</p>
  </div>
</article>
