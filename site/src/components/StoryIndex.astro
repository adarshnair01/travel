---
import Base from "../layouts/Base.astro";
import StoryCard from "./StoryCard.astro";
import Pagination from "./Pagination.astro";
import EmptyState from "./EmptyState.astro";
import { getPosts, collectCountries } from "../lib/posts";
import { SITE, url } from "../site";

interface Props {
  page: number;
}
const { page } = Astro.props;
const all = await getPosts();
const per = SITE.postsPerPage;
const total = Math.max(1, Math.ceil(all.length / per));
const pathFor = (n: number) => (n === 1 ? "/stories/" : `/stories/page/${n}/`);
const list = all.slice((page - 1) * per, page * per);
const years = [...new Set(all.map((p) => p.year))];
const countryNames = collectCountries(all).map((c) => c.name);
---

<Base
  title={page === 1 ? "All stories" : `Stories — page ${page}`}
  description={`All ${all.length} travel stories on ${SITE.blogName}: day-by-day itineraries, real costs and practical tips from ${countryNames.join(", ")}${page > 1 ? `. Page ${page} of ${total}` : ""}.`}
  path={pathFor(page)}
  prev={page > 1 ? pathFor(page - 1) : undefined}
  next={page < total ? pathFor(page + 1) : undefined}
  noindex={all.length === 0}
>
  <div class="wrap">
    <header class="page-head">
      <p class="eyebrow">Stories</p>
      <h1>{page === 1 ? "All stories" : `Stories — page ${page}`}</h1>
      <p>
        {all.length === 1 ? "1 story" : `${all.length} stories`}, newest first.
        {all.length > 0 && <>Press <kbd>/</kbd> to search.</>}
      </p>
    </header>
    {
      years.length > 1 && (
        <nav class="chip-row" aria-label="Years">
          {years.map((y) => <a class="tag" href={url(`/stories/${y}/`)}>{y}</a>)}
        </nav>
      )
    }
    {
      list.length ? (
        <div class="story-grid">{list.map((p, i) => <StoryCard post={p} eager={i < 3} />)}</div>
      ) : (
        <EmptyState />
      )
    }
    <Pagination current={page} total={total} pathFor={pathFor} />
  </div>
</Base>
