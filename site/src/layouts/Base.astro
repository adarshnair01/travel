---
import "../styles/global.css";
import { SITE, url, absUrl } from "../site";

interface Props {
  title?: string;
  description?: string;
  path: string; // relative to base, used for canonical
  image?: string; // absolute URL or path relative to base
  imageAlt?: string;
  imageWidth?: number;
  imageHeight?: number;
  type?: "website" | "article" | "profile";
  jsonLd?: Record<string, unknown>[];
  noindex?: boolean;
  published?: Date;
  modified?: Date;
  tags?: string[];
  prev?: string;
  next?: string;
}

const {
  title,
  description = SITE.description,
  path,
  image,
  imageAlt,
  imageWidth,
  imageHeight,
  type = "website",
  jsonLd = [],
  noindex = false,
  published,
  modified,
  tags = [],
  prev,
  next,
} = Astro.props;

// Search results show about 60 characters, so the site name is only added when it fits.
const suffix = ` | ${SITE.blogName}`;
const fullTitle = !title
  ? `${SITE.blogName} | ${SITE.tagline}`
  : title.length + suffix.length <= 62
    ? `${title}${suffix}`
    : title;
const canonical = absUrl(path);
// Pages without their own image share the site-wide card (public/og-default.jpg, 1200×630).
const ogImage = image ? (image.startsWith("http") ? image : new URL(image, SITE.origin).href) : absUrl("/og-default.jpg");
const ogAlt = image ? imageAlt : `${SITE.blogName}: ${SITE.tagline}`;
const ogW = image ? imageWidth : 1200;
const ogH = image ? imageHeight : 630;
const current = Astro.url.pathname;

const siteGraph = [
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: SITE.blogName,
    url: absUrl("/"),
    inLanguage: SITE.lang,
    author: { "@type": "Person", name: SITE.author, url: absUrl("/about/") },
  },
];
const ld = path === "/" ? [...siteGraph, ...jsonLd] : jsonLd;
---

<!doctype html>
<html lang={SITE.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content={noindex ? "noindex, follow" : "index, follow, max-image-preview:large, max-snippet:-1"} />
    {prev && <link rel="prev" href={absUrl(prev)} />}
    {next && <link rel="next" href={absUrl(next)} />}
    <meta name="author" content={SITE.author} />
    {SITE.googleSiteVerification && <meta name="google-site-verification" content={SITE.googleSiteVerification} />}
    {SITE.bingSiteVerification && <meta name="msvalidate.01" content={SITE.bingSiteVerification} />}
    {SITE.adsense.client && <meta name="google-adsense-account" content={SITE.adsense.client} />}
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#faf8f4" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#14161a" media="(prefers-color-scheme: dark)" />
    <link rel="icon" type="image/svg+xml" href={url("/favicon.svg")} />
    <link rel="icon" type="image/png" sizes="48x48" href={url("/favicon-48.png")} />
    <link rel="apple-touch-icon" href={url("/apple-touch-icon.png")} />
    <link rel="alternate" type="application/rss+xml" title={SITE.blogName} href={url("/feed.xml")} />
    <link rel="sitemap" href={url("/sitemap.xml")} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <!-- Heading font loads without blocking the first paint (helps Core Web Vitals). -->
    <link
      rel="preload"
      as="style"
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,650&display=swap"
      onload="this.onload=null;this.rel='stylesheet'"
    />
    <noscript>
      <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,650&display=swap" />
    </noscript>

    <!-- Open Graph / Twitter -->
    <meta property="og:site_name" content={SITE.blogName} />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title ?? SITE.blogName} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    {ogW && <meta property="og:image:width" content={String(ogW)} />}
    {ogH && <meta property="og:image:height" content={String(ogH)} />}
    {ogAlt && <meta property="og:image:alt" content={ogAlt} />}
    <meta property="og:locale" content={SITE.locale} />
    {published && <meta property="article:published_time" content={published.toISOString()} />}
    {(modified ?? published) && type === "article" && <meta property="article:modified_time" content={(modified ?? published)!.toISOString()} />}
    {type === "article" && <meta property="article:author" content={SITE.author} />}
    {tags.map((t) => <meta property="article:tag" content={t} />)}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title ?? SITE.blogName} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    {ogAlt && <meta name="twitter:image:alt" content={ogAlt} />}

    {ld.map((obj) => <script type="application/ld+json" set:html={JSON.stringify(obj)} />)}

    <!-- Set theme before paint to avoid a flash -->
    <script is:inline>
      (() => {
        let t = null;
        try { t = localStorage.getItem("theme"); } catch {}
        if (t !== "light" && t !== "dark") t = matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
        document.documentElement.dataset.theme = t;
      })();
    </script>

    {
      import.meta.env.PROD && SITE.googleAnalytics && (
        <script is:inline define:vars={{ id: SITE.googleAnalytics, host: new URL(SITE.origin).hostname }}>
          // Only count real visitors on the live domain (not localhost previews).
          window.dataLayer = window.dataLayer || [];
          function gtag() { dataLayer.push(arguments); }
          window.gtag = gtag;
          if (location.hostname === host) {
            const s = document.createElement("script");
            s.async = true;
            s.src = "https://www.googletagmanager.com/gtag/js?id=" + id;
            document.head.appendChild(s);
            gtag("js", new Date());
            gtag("config", id);
          }
        </script>
      )
    }
    {
      import.meta.env.PROD && SITE.travelpayoutsDrive && (
        <script is:inline data-noptimize="1" data-cfasync="false" data-no-defer="1" data-cmp-ab="2" define:vars={{ drive: SITE.travelpayoutsDrive }}>
          // Travelpayouts Drive (affiliate network script); see SITE.travelpayoutsDrive.
          const s = document.createElement("script");
          s.async = 1;
          s.setAttribute("data-cmp-ab", "2");
          s.src = drive;
          document.head.appendChild(s);
        </script>
      )
    }
    <slot name="head" />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="wrap header-inner">
        <a class="brand" href={url("/")} aria-label={`${SITE.blogName} home`}>
          <span class="brand-mark" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="18" height="18"><circle cx="12" cy="12" r="9.5" fill="none" stroke="currentColor" stroke-width="1.8"></circle><path d="m15.8 8.2-2.4 5.2-5.2 2.4 2.4-5.2Z" fill="currentColor"></path></svg>
          </span>
          <span class="brand-text">
            <strong>{SITE.blogName}</strong>
            <small>by {SITE.author}</small>
          </span>
        </a>
        <nav class="nav" aria-label="Main">
          {
            SITE.nav.map((item) => {
              const href = url(item.href);
              const active = item.href === "/" ? current === href : current.startsWith(href);
              return (
                <a href={href} aria-current={active ? "page" : undefined}>
                  {item.label}
                </a>
              );
            })
          }
        </nav>
        <div class="header-actions">
          <button class="icon-btn search-trigger" type="button" data-search-open aria-label="Search stories (Ctrl K)">
            <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><circle cx="11" cy="11" r="7" fill="none" stroke="currentColor" stroke-width="2"></circle><path d="m20 20-3.5-3.5" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path></svg>
            <span class="kbd" aria-hidden="true">⌘K</span>
          </button>
          <button class="icon-btn" type="button" data-theme-toggle aria-label="Toggle dark mode">
            <svg class="i-sun" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><circle cx="12" cy="12" r="4.5" fill="none" stroke="currentColor" stroke-width="2"></circle><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path></svg>
            <svg class="i-moon" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"></path></svg>
          </button>
          <button class="icon-btn menu-btn" type="button" data-menu-toggle aria-expanded="false" aria-label="Open menu">
            <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path></svg>
          </button>
        </div>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap footer-inner">
        <p>© {new Date().getFullYear()} {SITE.author}. {SITE.tagline}.</p>
        <nav aria-label="Footer">
          <a href={url("/feed.xml")}>RSS</a>
          <a href={url("/tags/")}>Topics</a>
          <a href={SITE.socials.blog}>Data science blog</a>
          <a href={SITE.socials.linkedin} rel="me noopener">LinkedIn</a>
          <a href={url("/privacy/")}>Privacy</a>
        </nav>
      </div>
    </footer>

    <dialog class="search-dialog" aria-label="Search stories">
      <div class="search-shell">
        <div class="search-head">
          <span>Search {SITE.blogName}</span>
          <button class="icon-btn" type="button" data-search-close aria-label="Close search">✕</button>
        </div>
        <div id="pagefind-search"></div>
        <p class="search-hint">Tip: press <kbd>/</kbd> or <kbd>⌘K</kbd> anywhere to search.</p>
      </div>
    </dialog>

    <script is:inline type="application/json" id="ads-config" set:html={JSON.stringify({ client: SITE.adsense.client })} />
    <script>
      import { initChrome } from "../lib/chrome";
      import { initAds, initTracking } from "../lib/monetize";
      initChrome();
      initTracking();
      initAds();
    </script>
  </body>
</html>
